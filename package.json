{
	"name": "sql-playground",
	"private": true,
	"type": "module",
	"imports": {
		"#/*": "./src/*",
		"#ui/*": "./src/components/ui/*",
		"#components/*": "./src/components/*",
		"#icons/*": "./src/components/icons/*",
		"#hooks/*": "./src/hooks/*",
		"#store/*": "./src/store/*",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"postinstall": "node scripts/copy-wasm-to-public.mjs",
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"preview": "vite preview --port 3001",
		"deploy": "bun run build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"format": "biome format",
		"lint": "biome lint",
		"check": "biome check",
		"typecheck": "tsc --noEmit"
	},
	"trustedDependencies": ["esbuild", "lefthook", "lightningcss", "sharp", "workerd"],
	"dependencies": {
		"@base-ui/react": "^1.9.0",
		"@duckdb/duckdb-wasm": "^1.33.1-dev57.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@hugeicons/core-free-icons": "^4.4.0",
		"@hugeicons/react": "^1.1.10",
		"@monaco-editor/react": "^4.7.0",
		"@redheadphone/react-json-grid": "^1.0.1",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-router": "^1.170.46",
		"@tanstack/react-start": "^1.169.4",
		"@types/papaparse": "^5.5.2",
		"@types/sql.js": "^1.4.11",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.1",
		"hyparquet": "^1.32.0",
		"immer": "^11.2.9",
		"monaco-editor": "^0.57.0",
		"motion": "^14.8.0",
		"papaparse": "^5.7.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-resizable-panels": "^4.15.2",
		"shadcn": "^4.23.0",
		"sonner": "^2.0.8",
		"sql.js": "^1.15.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"use-immer": "^0.11.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@cloudflare/vite-plugin": "^1.66.0",
		"@rolldown/plugin-babel": "^0.3.0",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"babel-plugin-react-compiler": "^1.0.0",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"wrangler": "^4.156.0"
	}
}
